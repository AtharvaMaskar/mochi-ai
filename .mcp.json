{
  "mcpServers": {
    "falkordb": {
      "command": "npx",
      "args": ["-y", "@falkordb/mcpserver@1.3.0"],
      "env": {
        "FALKORDB_HOST": "${FALKORDB_HOST:-localhost}",
        "FALKORDB_PORT": "${FALKORDB_PORT:-6379}",
        "FALKORDB_USERNAME": "mochi_reader",
        "FALKORDB_PASSWORD": "${MOCHI_READER_PASSWORD}",
        "FALKORDB_DEFAULT_READONLY": "true",
        "FALKORDB_STRICT_READONLY": "true"
      }
    }
  }
}
