# Copy to .env. Never commit .env.
# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=change-me-admin          # 'default' user: Browser + admin only
MOCHI_READER_PASSWORD=change-me-reader     # user conversations, MCP server (read-only)
MOCHI_DREAM_PASSWORD=change-me-dream       # dream + loader (sole writer of mochi_company)
MOCHI_DEMO_USER_PASSWORD=change-me-demo    # user_demo tier

# LLM (pi-ai reads ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=
MOCHI_MODEL=claude-haiku-5-5
MOCHI_JUDGE_MODEL=claude-opus-5-5

# Pi Durable harness storage
MOCHI_SQLITE=./mochi.sqlite

# Simulated helpdesk (sim/)
SIM_URL=http://localhost:4010
SIM_API_KEY=sim-key
SIM_SPEED=60            # replay clock speed (x real time)
SIM_START=              # optional epoch ms; default = start of the final day
SIM_PAUSED=             # set to 1 to start paused
SIM_WEBHOOK_URL=http://localhost:4011/webhook
MOCHI_ADMIN_TOKEN=change-me-admin-token
