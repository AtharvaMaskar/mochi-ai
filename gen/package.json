{
  "name": "@mochi/gen",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "gen": "node --env-file-if-exists=../.env derive.ts",
    "listen": "node --env-file-if-exists=../.env listen.ts",
    "load": "node --env-file-if-exists=../.env load.ts",
    "test": "EMBED_PROVIDER=local node --test --test-concurrency=1 --test-timeout=120000",
    "check": "tsc -p . && npm test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@mochi/contracts": "*",
    "falkordb": "^6.8.0"
  }
}
