{
  "name": "mochi-brain",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["contracts", "gen", "agent", "bench", "ui", "landing"],
  "scripts": {
    "gen": "npm run gen -w gen",
    "load": "npm run load -w gen",
    "dream": "npm run dream -w agent",
    "bench": "npm run bench -w bench",
    "dev": "npm run dev -w agent",
    "build": "npm run build -w ui -w landing",
    "start": "node --env-file-if-exists=.env deploy/start.ts",
    "landing": "npm run dev -w landing",
    "test": "npm test --workspaces --if-present",
    "check": "tsc -p contracts && npm run check -w gen -w agent -w bench -w ui -w landing && node contracts/gen-css.ts --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
