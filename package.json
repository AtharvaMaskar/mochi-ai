{
  "name": "mochi-brain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "contracts",
    "gen",
    "sim",
    "agent",
    "bench",
    "ui",
    "landing"
  ],
  "scripts": {
    "gen": "npm run gen -w gen --",
    "sim:gen": "npm run gen -w sim --",
    "sim": "npm run sim -w sim",
    "listen": "npm run listen -w gen",
    "load": "npm run load -w gen",
    "dream": "npm run dream -w agent",
    "bench": "npm run bench -w bench --",
    "dev": "npm run sim & npm run listen & npm run dev -w agent",
    "landing": "npm run dev -w landing",
    "test": "npm test --workspaces --if-present",
    "check": "tsc -p contracts && npm run check -w gen -w sim -w agent -w bench -w ui -w landing && node contracts/gen-css.ts --check && node scripts/readme-cypher.ts --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
